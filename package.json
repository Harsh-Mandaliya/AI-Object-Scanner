{
  "name": "ai-object-scanner",
  "version": "2.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "npm --prefix server start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:all": "npm test && npm --prefix server test",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run lint && npm run test:all"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.0.2",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "~9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "license": "MIT",
  "author": "Harsh Mandaliya"
}
