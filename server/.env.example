# Copy this file to server/.env and fill in your own keys.
# Never commit server/.env.

PORT=4000

# Required for object identification and the chat assistant.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: product listings and prices (Google Shopping via SerpApi).
# Without it the app still identifies objects, it just skips the price search.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Optional overrides (defaults shown)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# SHOPPING_LOCATION=Ahmedabad, Gujarat, India
# SHOPPING_GOOGLE_DOMAIN=google.co.in
# SHOPPING_COUNTRY=in
# SHOPPING_LANGUAGE=en
# SHOPPING_CURRENCY=INR
# MAX_PRODUCTS=10
# MAX_IMAGE_MB=8
# UPSTREAM_TIMEOUT_MS=45000
# CORS_ORIGIN=*
